# Backend base URL the proxy + RSC fetches target (server-side only).
API_URL=http://localhost:8000

# --- Auth (NextAuth v5 + Google) ---
# Secret used by NextAuth to encrypt the session cookie/JWT. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID).
# Authorized redirect URI: https://<web-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared HS256 secret for the backend-facing token. MUST equal the backend's
# TRADE_GRADER_AUTH_BACKEND_SECRET.
AUTH_BACKEND_SECRET=

# Public URL of the web app (used by NextAuth for callbacks behind a proxy).
# AUTH_URL=https://<web-domain>

# Rollout bridge: the default league signed-in users are sent to from "/".
# Set this to the same id as the backend's ALLOWLISTED_LEAGUE_ID.
# LEAGUE_ID=

# Canonical host: when set, any other host (e.g. *.up.railway.app) 308-redirects
# here. Inert until set.
# CANONICAL_HOST=ffbdynasty.com

# Error monitoring (Sentry). Inert unless set. NEXT_PUBLIC_ reaches the browser.
# SENTRY_DSN=https://...ingest.sentry.io/...            # server/edge
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...  # browser
