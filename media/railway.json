{
  "$schema": "https://schema.up.railway.app/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "media/Dockerfile" },
  "deploy": {
    "startCommand": "python -m media.worker",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
