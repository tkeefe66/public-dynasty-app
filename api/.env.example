# Required by the backend to generate trade stories during refresh (claude-opus-4-8).
# If unset, refresh still completes graded and trade stories are skipped with a warning.
ANTHROPIC_API_KEY=

# Liveness: in-process scheduler that keeps already-cached leagues warm.
# TRADE_GRADER_AUTO_REFRESH=true                 # set false to disable the scheduler
# TRADE_GRADER_REFRESH_INTERVAL_SECONDS=10800    # auto-refresh interval, default 3 hours
# Override LLM model for all writers. Default: claude-haiku-4-5-20251001
# Set to claude-opus-4-8 in production for higher-quality trade stories.
# TRADE_GRADER_LLM_MODEL=claude-opus-4-8

# --- Identity / multi-tenant ---
# Identity DB (users + league memberships only; league analysis stays file-cached).
# Unset locally → a SQLite file under the cache dir. Prod uses Postgres:
# TRADE_GRADER_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# Shared HS256 secret — MUST match the web app's AUTH_BACKEND_SECRET. The
# frontend mints a backend-facing token with it; FastAPI verifies it.
# TRADE_GRADER_AUTH_BACKEND_SECRET=change-me-min-32-bytes
# Comma-separated emails granted admin (llm-cost / config endpoints).
# TRADE_GRADER_ADMIN_EMAILS=you@example.com
# Rollout bridge: one league any signed-in user may *read* without a membership
# row. Keeps the site usable before users import their own leagues. Once the
# add-league flow is in use, UNSET this to fully require memberships.
# TRADE_GRADER_ALLOWLISTED_LEAGUE_ID=
# Max leagues a single user can import (cost lever — each new league is a
# first-importer-pays cold build). Default 10.
# TRADE_GRADER_MAX_LEAGUES_PER_USER=10
# Global LLM spend ceiling per calendar month (USD). At/over this, refreshes
# still run but skip LLM prose (reusing cached). 0 = no cap.
# TRADE_GRADER_LLM_MONTHLY_BUDGET_USD=0
# Per-user rate limits (slowapi). Defaults shown.
# TRADE_GRADER_RATE_LIMIT_DEFAULT=120/minute
# TRADE_GRADER_RATE_LIMIT_DISCOVERY=15/minute
# Error monitoring (Sentry). Inert unless set.
# TRADE_GRADER_SENTRY_DSN=https://...ingest.sentry.io/...

# --- Yahoo ingestion (in progress) ---
# Credentials for the Yahoo app registered at developer.yahoo.com/apps/create.
# The Client ID is not sensitive; the Secret is — never commit it, never paste
# it into a chat or an issue. Redirect URIs registered on that app must include
# https://localhost:8000 (local token minting) and the production callback.
# TRADE_GRADER_YAHOO_CLIENT_ID=
# TRADE_GRADER_YAHOO_CLIENT_SECRET=
# The dev script also accepts the shorter spelling, whichever you already have:
# YAHOO_APP_CLIENT_ID=
# YAHOO_APP_SECRET=
#
# Dev-only, until the auth plan lands: a hand-minted Yahoo access token, and
# the league key to read. Mint both with `python3 scripts/yahoo_dev_token.py`.
# The access token expires after 1 hour — re-mint rather than trying to keep it.
# client_for_league() refuses this fallback unless the app is in debug mode, so
# a dev token can never become production's auth story by accident.
# YAHOO_DEV_ACCESS_TOKEN=
# YAHOO_DEV_LEAGUE_KEY=461.l.123456
